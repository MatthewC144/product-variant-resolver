PVR_CATALOG_PATH=data/catalog.json
PVR_HUMAN_CATALOG_PATH=data/human_backed_catalog.json
PVR_REVIEW_FAMILY_KNOWLEDGE_PATH=data/review_family_knowledge.json
PVR_REVIEW_FAMILY_KNOWLEDGE_MANIFEST_PATH=data/review_family_knowledge_manifest.json
PVR_BENCHMARK_PATH=data/benchmark.json
PVR_UI_PATH=ui
PVR_DATABASE_URL=postgresql+psycopg://pvr:pvr@postgres:5432/pvr
PVR_BACKEND=offline
PVR_DENSE_PROVIDER=hashing-v1
PVR_DENSE_DIMENSIONS=192
PVR_RERANKER_PROVIDER=heuristic-v1
PVR_RERANKER_ENABLED=false
# Neural opt-in requires provider=neural-pointwise-v1 plus explicit calibration/policy artifacts.
PVR_RERANKER_CONFIG_PATH=config/neural-reranker-comparison-v1.json
PVR_RERANKER_MODEL_PATH=model-cache/neural-reranker-comparison-v1/pointwise
PVR_CALIBRATION_ARTIFACT=
PVR_POLICY_ARTIFACT=
PVR_POLICY_VERSION=fixture-v1-rrf-trained-v2
PVR_CANDIDATE_LIMIT=25
PVR_DEBUG_ENABLED=true
PVR_TRACING_ENABLED=false
# Docker Compose host-side bind source for optional pinned local models.
PVR_MODEL_CACHE_PATH=./model-cache
